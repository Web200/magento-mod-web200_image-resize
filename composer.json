{
    "name": "web200/magento-mod-web200_image-resize",
    "description": "Magento 2 Module to add simple image resizing",
    "type": "magento2-module",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "rosell-dk/webp-convert": "^2.3",
        "enshrined/svg-sanitize": "^1.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Web200\\ImageResize\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
